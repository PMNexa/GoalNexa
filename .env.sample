# Copy to .env (gitignored) and fill in. Read by docker-compose.yml.

# Tailscale sidecar (optional - `docker compose --profile tailscale up -d tailscale`).
# Auth key: Tailscale admin console -> Settings -> Keys -> Generate auth key.
# Also enable MagicDNS + HTTPS Certificates on the admin console's DNS page.
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Device name on the tailnet -> https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=goalnexa

# Django + login tokens. Public (Funnel) needs real random values here -
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Changing JWT_SECRET logs everyone out. DJANGO_DEBUG=false also makes the
# refresh cookie Secure (HTTPS-only; Chrome still allows it on localhost).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_ME
JWT_SECRET=REPLACE_ME

# Hostnames Django answers (comma-separated; a leading "." matches
# subdomains). docker-compose.prod.yml requires it; the dev compose
# accepts any. Behind HTTPS on a real domain, also list the full origin
# in DJANGO_CSRF_TRUSTED_ORIGINS (for Django's own CSRF-checked forms).
DJANGO_ALLOWED_HOSTS=localhost,.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=
# HSTS max-age in seconds; 0 = off. Only once HTTPS is permanent.
DJANGO_HSTS_SECONDS=0

# Database. Empty = SQLite file in apps/main/backend (dev compose).
# docker-compose.prod.yml defaults to its own Postgres (password below);
# a managed Postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=
POSTGRES_PASSWORD=REPLACE_ME
# Auth rate limits (DRF rates: N/sec|min|hour|day) and how many proxies
# append to X-Forwarded-For in front of Django: 1 = nginx alone, 2 =
# nginx behind Cloudflare/a load balancer/Tailscale Funnel.
AUTH_LOGIN_RATE=10/min
AUTH_LOGIN_EMAIL_RATE=20/hour
AUTH_SIGNUP_RATE=10/hour
# Unset: 2 in docker-compose.yml (Funnel), 1 in docker-compose.prod.yml.
TRUSTED_PROXY_COUNT=
# docker-compose.prod.yml: gunicorn workers (~2 x cores + 1), host port.
WEB_CONCURRENCY=3
HTTP_PORT=55607

# Check-ins from scripts/webhooks with a metric's ingest token: rate per
# metric. Reminders link to GOALNEXA_PUBLIC_URL (unset = the address each
# user saved their reminder settings from).
GOALNEXA_INGEST_RATE=60/min
# Views of a public dashboard link, per client IP.
GOALNEXA_SHARED_DASHBOARD_RATE=120/min
GOALNEXA_PUBLIC_URL=

# What an AI client (MCP) gets tools for. Unset = goal tracking only:
# organizations, members, invitations, goals, metrics, check-ins, cycles,
# comments, activity - no user or role administration. `*` = every
# resource; or a comma-separated list (e.g. goals,metrics,check-ins).
MCP_RESOURCES=
# ChatGPT app listing: the domain-verification token OpenAI's dashboard
# shows, served at /.well-known/openai-apps-challenge. Unset = 404.
MCP_OPENAI_APPS_CHALLENGE=

# Outgoing email - password reset, email verification, invitations, and
# reminders/digests by email. smtp://user:pass@host:587 (STARTTLS),
# smtps://user:pass@host:465, or console:// (prints to the backend log).
# Percent-encode an @ in the user (%40). EMAIL_FROM is the sender address;
# its display name is set on the admin's System > Settings page.
EMAIL_URL=
EMAIL_FROM="GoalNexa <noreply@example.com>"
# Amazon SES only: a configuration set whose SNS topic reports bounces and
# complaints to /api/v1/email/ses-events, and that topic's ARN (comma-
# separated for several). Both are also System settings. docs/deployment.md.
EMAIL_SES_CONFIGURATION_SET=
EMAIL_SES_TOPIC_ARNS=
# Lifecycle email (onboarding, tips, milestones, win-back): on/off. Unset =
# the System setting, which defaults to off when self-hosted and on in saas
# mode. Needs GOALNEXA_PUBLIC_URL (links in the emails).
LIFECYCLE_ENABLED=
# Optional: lock account settings here instead of the admin page -
# AUTH_SIGNUP_POLICY (open | invite_only | closed),
# AUTH_ALLOWED_EMAIL_DOMAINS (comma-separated), AUTH_REQUIRE_EMAIL_VERIFICATION,
# AUTH_LOCKOUT_ATTEMPTS (wrong passwords before a lock; 0 = never) /
# AUTH_LOCKOUT_MINUTES, AUTH_PASSWORD_MIN_LENGTH, AUTH_PASSWORD_REJECT_COMMON,
# LIMIT_MAX_MEMBERS / LIMIT_MAX_GOALS (per organization; 0 = unlimited).

# Single sign-on with OpenID Connect providers (Google, Authentik,
# Keycloak, Entra ID, ...) - docs/sso.md. All three set = "Sign in with
# <OIDC_LABEL>" on the login page. Register this redirect URI at the
# provider: https://<your address>/api/v1/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=
# Optional. OIDC_SCOPES (default "openid email profile"); OIDC_TRUST_EMAIL=true
# for a provider that sends no email_verified claim (Entra ID);
# OIDC_REDIRECT_URI if the address Django sees isn't the public one.
# AUTH_PASSWORD_LOGIN=false makes SSO the only way in (also a setting on
# the admin page; =true here is the way back in if the provider breaks).
OIDC_SCOPES=
OIDC_TRUST_EMAIL=
OIDC_REDIRECT_URI=
AUTH_PASSWORD_LOGIN=
# More providers, each with its own button - one line of JSON in single
# quotes, the same redirect URI for all of them:
# OIDC_PROVIDERS='[{"id":"microsoft","label":"Microsoft","issuer":"https://login.microsoftonline.com/<tenant id>/v2.0","client_id":"...","client_secret":"...","trust_email":true}]'
OIDC_PROVIDERS=

# Frontend: "production" = built app (use when public), "dev" = Vite dev
# server with hot reload. `docker compose up -d main-frontend` to apply.
FRONTEND_MODE=production

# "self_hosted" (default) or "saas" - saas turns off first-run setup, so
# the first stranger to sign up doesn't become admin; make the operator's
# admin with `python manage.py grant_role <email> Admin`.
DEPLOYMENT_MODE=self_hosted
# Downstream builds only (e.g. a hosted edition): extra Django apps
# (comma-separated module names) and the pip args that install them,
# e.g. BACKEND_EXTRA_PIP=-e /apps/extensions/billing/backend (the
# production image installs every apps/extensions/*/backend by itself),
# and their settings as one JSON object, single-quoted:
# GOALNEXA_EXTENSION_SETTINGS='{"SOME_SETTING": "value"}'
GOALNEXA_EXTENSIONS=
BACKEND_EXTRA_PIP=
GOALNEXA_EXTENSION_SETTINGS=

# Swarm deploy (docker-stack.yml, scripts/deploy.sh) - put these in
# .env.production (gitignored), together with the keys above that
# docker-stack.yml reads. DATABASE_URL must be a managed Postgres there.
# CI (.github/workflows/deploy.yml) takes REGISTRY/DEPLOY_HOST from repo
# variables and the rest from the PROD_ENV secret instead.
DOMAIN=goalnexa.example.com
REGISTRY=registry.digitalocean.com/REPLACE_ME
DEPLOY_HOST=root@REPLACE_ME
BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
