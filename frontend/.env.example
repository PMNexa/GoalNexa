# Base URL for the backend API.
# Leave unset (default) to call relative /api/* paths - in `docker compose up`
# these are routed to the backend by the nginx entrypoint (see
# nginx/default.conf), and in standalone `npm run dev` they're routed by
# Vite's dev-server proxy (see vite.config.ts) to http://localhost:8000.
# Set this explicitly only to point the frontend at a different backend, e.g.
# a remote/staging API.
# VITE_API_BASE_URL=http://localhost:8000
