# Copy to .env and adjust for your environment.

ENV=dev

# asyncpg connection string.
DATABASE_URL=postgresql+asyncpg://goalnexa:goalnexa@localhost:5432/goalnexa

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# JSON array of allowed browser origins (needed for the refresh cookie, which
# requires allow_credentials=True on the CORS side too).
CORS_ORIGINS=["http://localhost:5173"]

# Used to build invite links returned by POST /orgs/{org_id}/members/invite.
APP_BASE_URL=http://localhost:8000
