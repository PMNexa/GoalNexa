# Copy to .env and adjust for your environment.
#
# These are exactly the settings apps/platform-core/backend/app/core/config.py's
# Settings class reads (no GoalNexa-specific config exists — see README.md's
# "consume in place" note). CORS is deliberately not configurable here:
# platform-core's own main.py hardcodes a permissive CORS policy, which is
# fine because nginx (see ../nginx/default.conf) makes the frontend and API
# same-origin from the browser's perspective — CORS never actually applies.

ENV=dev

# asyncpg connection string.
DATABASE_URL=postgresql+asyncpg://goalnexa:goalnexa@localhost:5432/goalnexa

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Used to build invite links returned by POST /orgs/{org_id}/members/invite.
# Points at the frontend's public URL (the single nginx entrypoint in
# docker-compose), not the backend itself - the invite link is a page for a
# human to open in a browser.
APP_BASE_URL=http://localhost:30566
